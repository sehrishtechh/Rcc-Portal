# Public browser/server values from the RCC development Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Not required for normal user-facing operations; if ever used
# for a trusted maintenance task, keep it server-only and out of browser bundles.
# SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to form authentication email callback links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
